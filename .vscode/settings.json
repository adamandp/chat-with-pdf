{
  "files.exclude": {
    "**/.agents": true,
    "**/.claude": true,
    "**/.cursor": true,
    "**/.devin": true,
    "**/.windsurf": true,
    "**/.vscode": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/coverage": true,
    "**/*.tsbuildinfo": true,
    "**/package-lock.json": true,
    "**/bun.lock": true,
    "**/skills-lock.json": true
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "package.json": "package-lock.json, bun.lock, skills-lock.json",
    "tsconfig.json": "tsconfig.*.json",
    ".env": ".env.*"
  }
}
