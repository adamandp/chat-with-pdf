{
  "openapi": "3.0.3",
  "info": {
    "title": "PDF Chat API",
    "version": "1.0.0"
  },
  "paths": {
    "/chat": {
      "post": {
        "summary": "Ask a question about owned ready PDFs",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "question",
                  "document_ids"
                ],
                "properties": {
                  "question": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8000
                  },
                  "document_ids": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 10,
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "session_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "quick",
                      "pro",
                      "ultra"
                    ],
                    "default": "quick",
                    "description": "Per-turn mode. quick: compact history, one search and answer. pro: expanded active-branch history, optional rewrite, one search and answer. ultra: LangGraph with evaluation and up to three searches. All modes persist full messages in the same session."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Answer and message pair persisted atomically",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "session_id",
                        "message_id",
                        "answer",
                        "sources",
                        "search_attempts",
                        "context_sufficient",
                        "mode"
                      ],
                      "properties": {
                        "session_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "message_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "answer": {
                          "type": "string"
                        },
                        "sources": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": [
                              "source_id",
                              "document_id",
                              "filename",
                              "page",
                              "chunk_id"
                            ],
                            "properties": {
                              "source_id": {
                                "type": "integer",
                                "minimum": 1
                              },
                              "document_id": {
                                "type": "string",
                                "format": "uuid"
                              },
                              "filename": {
                                "type": "string"
                              },
                              "page": {
                                "type": "integer"
                              },
                              "chunk_id": {
                                "type": "string"
                              }
                            }
                          }
                        },
                        "search_attempts": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 3
                        },
                        "context_sufficient": {
                          "type": "boolean",
                          "nullable": true,
                          "description": "Ultra evaluation result. For quick/pro, null when evidence exists because no separate evaluation runs; false when retrieval is empty."
                        },
                        "mode": {
                          "type": "string",
                          "enum": [
                            "quick",
                            "pro",
                            "ultra"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing or invalid authentication"
          },
          "404": {
            "description": "Document or conversation unavailable to this user"
          },
          "409": {
            "description": "Document not ready or conversation changed; refresh before retrying"
          },
          "503": {
            "description": "Generation failed; no messages saved"
          },
          "429": {
            "description": "AI provider rate limit or quota exhausted; no messages saved. Check provider quota if persistent."
          },
          "504": {
            "description": "Model operation or total generation deadline exceeded; no messages saved."
          }
        }
      }
    },
    "/chat/stream": {
      "post": {
        "summary": "Stream chat progress, answer text, and the persisted final answer over SSE",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "question",
                  "document_ids"
                ],
                "properties": {
                  "question": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8000
                  },
                  "document_ids": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 10,
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "session_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "quick",
                      "pro",
                      "ultra"
                    ],
                    "default": "quick",
                    "description": "Per-turn mode. quick: compact history, one search and answer. pro: expanded active-branch history, optional rewrite, one search and answer. ultra: LangGraph with evaluation and up to three searches. All modes persist full messages in the same session."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Every SSE JSON payload is {type,data}, with type matching the event name. progress.data: {stage,message,attempt?}; token.data: {text} (provisional until done); done.data: the result inside POST /chat response.data; error.data: {status_code,message}. Stream closes after done/error. HTTP status remains 200 on post-header failures. error.data.status_code is 429 for provider rate limits/quota and 503 for other generation failures. Timeouts use error.data.status_code 504.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "example": "event: progress\ndata: {\"type\": \"progress\", \"data\": {\"stage\": \"searching\", \"message\": \"Mencari informasi di dokumen.\", \"attempt\": 1}}\n\n"
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing or invalid authentication"
          },
          "404": {
            "description": "Document or conversation unavailable to this user"
          },
          "409": {
            "description": "Document not ready or conversation changed; refresh before retrying"
          },
          "503": {
            "description": "Generation failed or timed out; no messages saved"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
