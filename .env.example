# PostgreSQL
DATABASE_URL="postgresql://postgres:your_database_password@localhost:5432/chat_with_pdf?schema=public"

# Seeding
SEED_DEMO=false
SEED_EXPECTED_DB_NAME=chat_with_pdf
SEED_USERNAME=your_username
SEED_PASSWORD=your_seed_password
SEED_DEMO_PASSWORD=your_demo_password

# Milvus
MILVUS_ADDRESS="localhost:19530"
MILVUS_TOKEN=""
MILVUS_SSL=false
MILVUS_DATABASE="default"

# Authentication: generate a random secret of at least 32 bytes.
ACCESS_JWT_SECRET="replace_with_a_random_secret_at_least_32_bytes"
FRONTEND_ORIGINS="http://localhost:3001"
REFRESH_JWT_SECRET="replace_with_a_different_random_secret"

# PDF storage (host:port, no URL scheme)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=local-minio
MINIO_SECRET_KEY=replace-with-a-long-random-password
MINIO_BUCKET=documents
MINIO_SECURE=false
MAX_PDF_BYTES=20971520

# RAG models: official LangChain.js and LangGraph.js, in this Nest application.
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
MILVUS_COLLECTION=pdf_chunks_gemini_v1
# Optional OpenAI-compatible provider, select with *_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small

# BullMQ document processing (Redis must use maxmemory-policy noeviction)
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=chat-pdf

# Optional override for local model simulations; leave empty for Gemini.
# GEMINI_CHAT_BASE_URL=http://localhost:14901/chat-model

# Deadline per chat model operation, including retries.
CHAT_MODEL_TIMEOUT_MS=30000

# Local diagnostics: saves full LLM prompts/PDF evidence per chat session, without credentials.
CHAT_DEBUG_REQUESTS=false
CHAT_DEBUG_REQUESTS_DIR=logs/llm-requests
