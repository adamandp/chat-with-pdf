# PostgreSQL
DATABASE_URL="postgresql://postgres:your_database_password@localhost:5432/chat_with_pdf?schema=public"

# Seeding
SEED_DEMO=false
SEED_EXPECTED_DB_NAME=chat_with_pdf
SEED_USERNAME=your_username
SEED_PASSWORD=your_seed_password
SEED_DEMO_PASSWORD=your_demo_password

# Milvus
MILVUS_ADDRESS="localhost:19530"
MILVUS_TOKEN=""
MILVUS_SSL=false
MILVUS_DATABASE="default"cle