generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum FeedbackType {
  LIKE    @map("like")
  DISLIKE @map("dislike")

  @@map("feedback_type")
}

enum DocumentStatus {
  PENDING_UPLOAD @map("pending_upload")
  QUEUED         @map("queued")
  PROCESSING     @map("processing")
  READY          @map("ready")
  FAILED         @map("failed")
  DELETING       @map("deleting")
  DELETED        @map("deleted")

  @@map("document_status")
}

enum ChatHistoryStatus {
  PENDING   @map("pending")
  STREAMING @map("streaming")
  COMPLETED @map("completed")
  FAILED    @map("failed")
  CANCELLED @map("cancelled")

  @@map("chat_history_status")
}

model User {
  id           String    @id @default(uuid()) @map("id") @db.Uuid
  username     String?   @unique @map("username") @db.VarChar(255)
  name         String?   @map("name") @db.VarChar(255)
  passwordHash String?   @map("password_hash") @db.Text
  role         String    @default("user") @map("role") @db.VarChar(20)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  authSessions AuthSession[]
  chatSessions ChatSession[]
  documents    Document[]

  @@map("users")
}

model AuthSession {
  id               String    @id @default(uuid()) @map("id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(64)
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@map("auth_sessions")
}

model ChatSession {
  id                  String    @id @default(uuid()) @map("id") @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  title               String?   @default("New Chat") @map("title") @db.VarChar(255)
  answerMode          String?   @default("document_only") @map("answer_mode") @db.VarChar(30)
  activeLeafMessageId String?   @map("active_leaf_message_id") @db.Uuid
  lastMessageAt       DateTime? @map("last_message_at") @db.Timestamptz(6)
  createdAt           DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)

  user              User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  activeLeafMessage ChatHistory?      @relation("ActiveLeafMessage", fields: [activeLeafMessageId], references: [id], onDelete: SetNull)
  messages          ChatHistory[]     @relation("SessionMessages")
  sessionDocuments  SessionDocument[]

  @@index([userId, lastMessageAt])
  @@index([activeLeafMessageId])
  @@map("chat_session")
}

model ChatHistory {
  id              String            @id @default(uuid()) @map("id") @db.Uuid
  sessionId       String            @map("session_id") @db.Uuid
  parentMessageId String?           @map("parent_message_id") @db.Uuid
  versionGroupId  String            @default(uuid()) @map("version_group_id") @db.Uuid
  role            String            @map("role") @db.VarChar(20)
  content         String            @default("") @map("content") @db.Text
  sources         Json              @default("[]") @map("sources")
  answerMode      String?           @map("answer_mode") @db.VarChar(30)
  status          ChatHistoryStatus @default(PENDING) @map("status")
  createdAt       DateTime?         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime?         @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?         @map("deleted_at") @db.Timestamptz(6)

  session           ChatSession   @relation("SessionMessages", fields: [sessionId], references: [id], onDelete: Restrict)
  parentMessage     ChatHistory?  @relation("MessageTree", fields: [parentMessageId], references: [id], onDelete: SetNull)
  childMessages     ChatHistory[] @relation("MessageTree")
  activeForSessions ChatSession[] @relation("ActiveLeafMessage")
  feedback          ChatFeedback?
  completions       Completion[]

  @@index([sessionId, createdAt])
  @@index([parentMessageId])
  @@index([versionGroupId])
  @@map("chat_history")
}

model ChatFeedback {
  id            Int          @id @default(autoincrement()) @map("id")
  chatHistoryId String       @unique @map("chat_history_id") @db.Uuid
  type          FeedbackType @map("type")
  createdAt     DateTime?    @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime?    @default(now()) @map("updated_at") @db.Timestamp(6)

  chatHistory ChatHistory @relation(fields: [chatHistoryId], references: [id], onDelete: Restrict)

  @@map("chat_feedback")
}

model Completion {
  id                 String    @id @default(uuid()) @map("id") @db.Uuid
  chatHistoryId      String    @map("chat_history_id") @db.Uuid
  model              String    @map("model") @db.VarChar(100)
  provider           String    @map("provider") @db.VarChar(50)
  inputTokens        Int?      @default(0) @map("input_tokens")
  outputTokens       Int?      @default(0) @map("output_tokens")
  totalTokens        Int?      @default(0) @map("total_tokens")
  inputCost          Decimal?  @default(0) @map("input_cost") @db.Decimal(12, 8)
  outputCost         Decimal?  @default(0) @map("output_cost") @db.Decimal(12, 8)
  totalCost          Decimal?  @default(0) @map("total_cost") @db.Decimal(12, 8)
  latencyMs          Int?      @map("latency_ms")
  timeToFirstTokenMs Int?      @map("time_to_first_token_ms")
  status             String    @map("status") @db.VarChar(20)
  errorMessage       String?   @map("error_message") @db.Text
  startedAt          DateTime? @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt        DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt          DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  chatHistory ChatHistory @relation(fields: [chatHistoryId], references: [id], onDelete: Restrict)

  @@index([chatHistoryId])
  @@map("completions")
}

model Document {
  id           String         @id @default(uuid()) @map("id") @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  fileName     String?        @map("filename") @db.VarChar(255)
  fileSize     BigInt?        @map("file_size")
  mimeType     String?        @map("mime_type") @db.VarChar(100)
  sha256Hash   String?        @map("sha256_hash") @db.VarChar(64)
  pageCount    Int?           @map("page_count")
  chunkCount   Int?           @default(0) @map("chunk_count")
  status       DocumentStatus @default(PENDING_UPLOAD) @map("status")
  errorMessage String?        @map("error_message") @db.Text
  createdAt    DateTime?      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime?      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz(6)

  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessionDocuments SessionDocument[]

  @@index([userId])
  @@index([sha256Hash])
  @@map("documents")
}

model SessionDocument {
  sessionId  String    @map("session_id") @db.Uuid
  documentId String    @map("document_id") @db.Uuid
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  session  ChatSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  document Document    @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@id([sessionId, documentId])
  @@index([documentId])
  @@map("session_documents")
}
